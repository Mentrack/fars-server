// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model User {
  id           String                    @id @default(uuid())
  firstName    String
  lastName     String
  username     String                    @unique
  phone        String?                   @unique
  email        String                    @unique
  password     String
  avatarUrl    String                   @default("https://gravatar.com/avatar/48c3863a0f03a81d67916d28fdaa0ea6?s=400&d=mp&r=pg")
  role         UserRole                 @default(STAFF)
  isActive     Boolean                  @default(true)
  refreshToken String?

  deactivatedAt DateTime?  // When the user was deactivated
  deactivatedById String?  // Who deactivated them
  deactivationReason String? // Reason for deactivation


  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  // 🔐 Authentication-related
  tokens       Token[]                   // required for Prisma schema validation
  
  // Transactions assigned to this user
  BankTransaction BankTransaction[]
  
  // 👥 Staff accounts assigned to this user
  StaffAccountAssignment StaffAccountAssignment[]

  // 👮‍♂️ Permissions assigned to this user
  permissions  Permission[]              @relation("UserPermissions")
  
  // 🧾 Transactions uploaded by this user
  uploadedTransactions BankTransaction[] @relation("UserUploadedTransactions")

  // 👥 Assignments to bank accounts
  staffAssignments      StaffAccountAssignment[] @relation("StaffAssignments")

  // 🧑‍🏫 Admins who assign staff to accounts
  assignedStaffAccounts StaffAccountAssignment[] @relation("AssignedBy")

  uploadedDocuments Document[]  // 👈 inverse relation: one user → many documents

  // 👤 User that deactivated this user
  deactivatedBy User?      @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedUsers User[]  @relation("UserDeactivatedBy")  // Users this user deactivated

  @@map("users")
}


model Permission {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]   @relation("UserPermissions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model Token {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresIn DateTime 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
  @@index([userId])
}

enum ClassificationCode {
  CD     // Cash/Cheque Deposit
  LCD    // Local Cheque Deposit
  UCD    // Up Country Deposit
  LD     // Loan Disbursement
  RET    // Return (Inwards/Outwards)
  REV    // Reversal (Credit or Debit)
  INT    // Interest
  CW     // Cash/Cheque Withdrawal
  IT     // Internal Transfer
  ET     // External Transfer
  LR     // Loan Repayment
  LNT    // Loan Interest
  CO     // Commission (WHT)
  FEE    // Lending/Legal Fee
  MC     // Miscellaneous Charge
  CAMF   // Current Account Maintenance Fee
  VAT    // VAT on Fees
}

enum Category {
  DEPOSIT
  WITHDRAWAL
}

model TransactionClassification {
  id          String              @id @default(uuid())
  code        ClassificationCode  @unique// Unique code for classification (e.g. CD, LCD, etc.)
  category    Category              // Deposit, Withdrawal, Fee
  label       String              // Human-readable name (e.g. Loan Disbursement)
  description String?             // Optional explanation
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  transactions BankTransaction[]  // One-to-many from classification

  @@map("transaction_classifications")
}

enum TransactionType {
  CREDIT
  DEBIT
}

model BankTransaction {
  id               String                    @id @default(uuid())
  bankAccountId    String
  uploadedById     String
  transactionDate  DateTime
  valueDate        DateTime
  amount           Float
  type             TransactionType                    // 'credit' or 'debit'
  description      String
  reference        String?
  chequeNo         String?
  tellerNo         String?
  currency         String
  classificationId String
  user             String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  bankAccount      BankAccount               @relation(fields: [bankAccountId], references: [id])
  uploadedBy       User                      @relation(fields: [uploadedById], references: [id])
  classification   TransactionClassification @relation(fields: [classificationId], references: [id])
  User             User[]                    @relation("UserUploadedTransactions")

  @@map("bank_transactions")
}

enum AccountType {
  CURRENT
  SAVINGS
}

model BankAccount {
  id               String                  @id @default(uuid())
  code             String                  @unique
  bankId           String
  accountNumber    String                  @unique
  accountName      String
  accountType      AccountType
  currency         String
  clientId         String
  rateId           String?

  client           Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rate             AccountRate?            @relation(fields: [rateId], references: [id])
  bank             Bank                    @relation(fields: [bankId], references: [id])

  staffAssignments StaffAccountAssignment[]
  transactions     BankTransaction[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("bank_accounts")
}

model Bank {
  id               String                  @id @default(uuid())
  name             String
  code             String                  @unique
  bankAccounts     BankAccount[] // One-to-many relation
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("banks")
}

model Client {
  id        String         @id @default(uuid())
  firstName String
  lastName  String
  companyName String       @unique
  email     String         @unique
  address   String?
  phone     String?
  country   String?
  state     String?
  city      String?
  avatarUrl String         @default("https://gravatar.com/avatar/48c3863a0f03a81d67916d28fdaa0ea6?s=400&d=mp&r=pg")
  accounts  BankAccount[]
  rates     AccountRate[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  

  @@map("clients")
}

model AccountRate {
  id                       String        @id @default(uuid())
  clientId                 String        // 👈 links to client
  code                     String        @unique // Unique code for the rate configuration
  drRates                  Json?         // array of { rate, effectiveFrom, effectiveTo }
  loanInterestRates        Json?
  lcCommissions            Json?
  preNegotiationRates      Json?
  postNegotiationRates     Json?
  creditInterestRates      Json?

  returnChargeRate         Float?
  returnChargeLimit        Float?
  cotCovenantRate          Float?
  cotOffCoverRate          Float?
  cotOICRate               Float?
  turnoverLimit            Float?
  cotCovenantFrequency     String?
  chargeCOTOnShortfall     Boolean?
  debitRate                Float?
  excessRate               Float?
  excessRateType           String?
  vatRate                  Float?
  whtRate                  Float?
  rateType                 String?
  currency                 String?
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  client                   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bankAccounts             BankAccount[] // one rate config → many bank accounts
  documents                Document[]    @relation("RateDocuments")

  @@map("account_rates")
}

enum DocumentType {
  CONTRACT 
  BANK_STATEMENT
}

model Document {
  id            String        @id @default(uuid())
  code          String        @unique
  title         String
  url           String
  type          DocumentType
  uploadedById  String
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])

  rates         AccountRate[] @relation("RateDocuments")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("documents")
}

model StaffAccountAssignment {
  id            String       @id @default(uuid())
  userId        String
  accountId     String
  assignedById  String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  bankAccount   BankAccount  @relation(fields: [accountId], references: [id])
  assignedBy    User         @relation("AssignedBy", fields: [assignedById], references: [id])
  User          User[]       @relation("StaffAssignments")

  @@unique([userId, accountId])

  @@map("staff_account_assignments")
}