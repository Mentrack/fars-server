// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model User {
  id           String                    @id @default(uuid())
  firstName    String
  lastName     String
  username     String                    @unique
  email        String                    @unique
  password     String
  avatarUrl    String                    @default("https://gravatar.com/avatar/48c3863a0f03a81d67916d28fdaa0ea6?s=400&d=mp&r=pg")
  role         UserRole                  @default(STAFF)
  isActive     Boolean                   @default(true)
  refreshToken String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  // 🔐 Authentication-related
  tokens       Token[]                   // required for Prisma schema validation
  
  // Transactions assigned to this user
  BankTransaction BankTransaction[]
  
  // 👥 Staff accounts assigned to this user
  StaffAccountAssignment StaffAccountAssignment[]

  // 👮‍♂️ Permissions assigned to this user
  permissions  Permission[]              @relation("UserPermissions")
  
  // 🧾 Transactions uploaded by this user
  uploadedTransactions BankTransaction[] @relation("UserUploadedTransactions")

  // 👥 Assignments to bank accounts
  staffAssignments      StaffAccountAssignment[] @relation("StaffAssignments")

  // 🧑‍🏫 Admins who assign staff to accounts
  assignedStaffAccounts StaffAccountAssignment[] @relation("AssignedBy")

  @@map("users")
}


model Permission {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]   @relation("UserPermissions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model Token {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresIn DateTime 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
  @@index([userId])
}

enum ClassificationCode {
  CD     // Cash/Cheque Deposit
  LCD    // Local Cheque Deposit
  UCD    // Up Country Deposit
  LD     // Loan Disbursement
  RET    // Return (Inwards/Outwards)
  REV    // Reversal (Credit or Debit)
  INT    // Interest
  CW     // Cash/Cheque Withdrawal
  IT     // Internal Transfer
  ET     // External Transfer
  LR     // Loan Repayment
  LNT    // Loan Interest
  CO     // Commission (WHT)
  FEE    // Lending/Legal Fee
  MC     // Miscellaneous Charge
  CAMF   // Current Account Maintenance Fee
  VAT    // VAT on Fees
}

model TransactionClassification {
  id          String              @id @default(uuid())
  code        ClassificationCode
  category    String              // Deposit, Withdrawal, Fee
  label       String              // Human-readable name (e.g. Loan Disbursement)
  description String?             // Optional explanation
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  transactions BankTransaction[]  // One-to-many from classification

  @@map("transaction_classifications")
}

enum TransactionType {
  CREDIT
  DEBIT
}

model BankTransaction {
  id               String                    @id @default(uuid())
  bankAccountId    String
  uploadedById     String
  transactionDate  DateTime
  valueDate        DateTime
  amount           Float
  type             TransactionType                    // 'credit' or 'debit'
  description      String
  reference        String?
  chequeNo         String?
  tellerNo         String?
  currency         String
  classificationId String
  user             String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  bankAccount      BankAccount               @relation(fields: [bankAccountId], references: [id])
  uploadedBy       User                      @relation(fields: [uploadedById], references: [id])
  classification   TransactionClassification @relation(fields: [classificationId], references: [id])
  User             User[]                    @relation("UserUploadedTransactions")

  @@map("bank_transactions")
}

enum AccountType {
  CURRENT
  SAVINGS
}

model BankAccount {
  id              String                  @id @default(uuid())
  accountNumber   String                  @unique
  accountName     String
  accountType     AccountType
  currency        String
  clientId        String
  contract          AccountContract?      @relation("BankAccountToContract")
  staffAssignments StaffAccountAssignment[]
  transactions    BankTransaction[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Client that owns this account
  client          Client                  @relation(fields: [clientId], references: [id])
  
  @@map("bank_accounts")
}

model Client {
  id        String         @id @default(uuid())
  firstName String
  lastName  String
  companyName String       @unique
  email     String         @unique
  address   String?
  phone     String?
  country   String?
  state     String?
  city      String?
  accounts  BankAccount[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("clients")
}

model AccountContract {
  id                     String   @id @default(uuid())
  bankAccountId          String   @unique
  returnChargeRate       Float?
  returnChargeLimit      Float?
  cotCovenantRate        Float?
  cotOffCoverRate        Float?
  cotOICRate             Float?
  turnoverLimit          Float?
  cotCovenantFrequency   String?
  chargeCOTOnShortfall   Boolean?
  creditInterestRate     Float?
  debitRate              Float?
  excessRate             Float?
  excessRateType         String?
  vatRate                Float?
  whtRate                Float?
  rateType               String?
  effectiveFrom          DateTime?
  effectiveTo            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bankAccount BankAccount @relation("BankAccountToContract", fields: [bankAccountId], references: [id], onDelete: Cascade)


  @@map("account_contracts")
}

model StaffAccountAssignment {
  id            String       @id @default(uuid())
  userId        String
  accountId     String
  assignedById  String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  bankAccount   BankAccount  @relation(fields: [accountId], references: [id])
  assignedBy    User         @relation("AssignedBy", fields: [assignedById], references: [id])
  User          User[]       @relation("StaffAssignments")

  @@unique([userId, accountId])

  @@map("staff_account_assignments")
}

