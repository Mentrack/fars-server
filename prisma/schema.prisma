// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CLIENT
  BANK
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  username     String   @unique
  phone        String?  @unique
  email        String   @unique
  password     String
  avatarUrl    String   @default("https://gravatar.com/avatar/48c3863a0f03a81d67916d28fdaa0ea6?s=400&d=mp&r=pg")
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  refreshToken String?

  deactivatedAt      DateTime? // When the user was deactivated
  deactivatedById    String? // Who deactivated them
  deactivationReason String? // Reason for deactivation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔐 Authentication-related
  tokens Token[] // required for Prisma schema validation

  // Transactions assigned to this user
  BankTransaction BankTransaction[]

  // 📝  Rate comments made by this user
  comments RateComment[]

  // 👥 Staff accounts assigned to this user
  StaffAccountAssignment StaffAccountAssignment[]

  // 👮‍♂️ Permissions assigned to this user
  permissions Permission[] @relation("UserPermissions")

  // 👥 Assignments to bank accounts
  staffAssignments StaffAccountAssignment[] @relation("StaffAssignments")

  // 🧑‍🏫 Admins who assign staff to accounts
  assignedStaffAccounts StaffAccountAssignment[] @relation("AssignedBy")

  uploadedDocuments Document[] // 👈 inverse relation: one user → many documents

  // 👤 User that deactivated this user
  deactivatedBy    User?  @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedUsers User[] @relation("UserDeactivatedBy") // Users this user deactivated

  @@map("users")
}

model Permission {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]   @relation("UserPermissions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model Token {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresIn DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tokens")
}

enum ClassificationCode {
  CD // Cash/Cheque Deposit
  LCD // Local Cheque Deposit
  UCD // Up Country Deposit
  LD // Loan Disbursement
  RET // Return (Inwards/Outwards)
  REV // Reversal (Credit or Debit)
  INT // Interest
  CW // Cash/Cheque Withdrawal
  IT // Internal Transaction
  ET // External Transfer
  LR // Loan Repayment
  LNT // Loan Interest
  CO // Commission (WHT)
  FEE // Lending/Legal Fee
  VF // Vat on Lending/Legal Fee
  MC // Miscellaneous Charge
  CAMF // Current Account Maintenance Fee
  VC // Vat on Current Account Maintenance Fee 
  WHT // Withholding Tax
}

enum Category {
  DEPOSIT
  WITHDRAWAL
}

model TransactionClassification {
  id           String                  @id @default(uuid())
  code         ClassificationCode      @unique // Code for classification (e.g. CD, LCD, etc.)
  category     Category // Deposit, Withdrawal
  label        String // Human-readable name (e.g. Loan Disbursement)
  description  String? // Optional explanation
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  patterns     ClassificationPattern[] // One-to-many from classification
  transactions BankTransaction[] // One-to-many from classification

  @@map("transaction_classifications")
}

model ClassificationPattern {
  id               String  @id @default(uuid())
  keyword          String // or regex
  isRegex          Boolean @default(false)
  bankId           String? // optional for global
  classificationId String

  bank           Bank?                     @relation(fields: [bankId], references: [id])
  classification TransactionClassification @relation(fields: [classificationId], references: [id])
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([keyword, classificationId, bankId])
  @@unique([classificationId, keyword, isRegex])
  @@map("classification_patterns")
}

enum TransactionType {
  CREDIT
  DEBIT
}

model BankTransaction {
  id               String          @id @default(uuid())
  bankAccountId    String
  uploadedById     String
  transactionDate  DateTime
  valueDate        DateTime
  amount           Float
  balance          Float
  type             TransactionType // 'CREDIT' or 'DEBIT'
  description      String
  reference        String?
  chequeNo         String?
  tellerNo         String?
  classificationId String
  user             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isReversal       Boolean         @default(false) // Indicates if this transaction is a reversal of a previous transaction

  bankAccount    BankAccount               @relation(fields: [bankAccountId], references: [id])
  uploadedBy     User                      @relation(fields: [uploadedById], references: [id])
  classification TransactionClassification @relation(fields: [classificationId], references: [id])

  @@index([valueDate, transactionDate, createdAt, bankAccountId])
  @@map("bank_transactions")
}

model ReversalKeyword {
  id        String   @id @default(uuid())
  keyword   String
  isGlobal  Boolean?  @default(false) // ✅ if true, applies to all banks
  bankId    String? // 🔄 optional if bank-specific
  bank      Bank?    @relation(fields: [bankId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([keyword, bankId])
  @@map("reversal_keywords")
}

enum AccountType {
  CURRENT
  SAVINGS
}

model BankAccount {
  id             String      @id @default(uuid())
  code           String      @unique
  bankId         String
  accountNumber  String     
  accountName    String
  accountType    AccountType
  currency       String
  openingBalance Float       @default(0)
  clientId       String
  rateId         String?

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rate   AccountRate? @relation(fields: [rateId], references: [id])
  bank   Bank         @relation(fields: [bankId], references: [id])

  staffAssignments StaffAccountAssignment[]
  transactions     BankTransaction[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  documents    Document[]    @relation("TransactionDocuments")

  @@unique([bankId, accountNumber]) // Unique constraint for bank + account number
  @@map("bank_accounts")
}

model Bank {
  id           String        @id @default(uuid())
  name         String        @unique // Unique name of the bank
  code         String        @unique
  bankAccounts BankAccount[] // One-to-many relation
  accountRates  AccountRate[] // One-to-many relation
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  ReversalKeyword       ReversalKeyword[]
  ClassificationPattern ClassificationPattern[]

  @@map("banks")
}

model Client {
  id          String        @id @default(uuid())
  firstName   String
  lastName    String
  companyName String        @unique
  email       String        @unique
  address     String?
  phone       String?
  country     String?
  state       String?
  city        String?
  avatarUrl   String        @default("https://gravatar.com/avatar/48c3863a0f03a81d67916d28fdaa0ea6?s=400&d=mp&r=pg")
  accounts    BankAccount[]
  rates       AccountRate[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("clients")
}

model AccountRate {
  id                   String @id @default(uuid())
  clientId             String // 👈 links to client
  bankId               String // 👈 links to bank
  code                 String @unique // Unique code for the rate configuration
  drRates              Json? // array of { rate, effectiveFrom, effectiveTo }
  loanInterestRates    Json?
  lcCommissions        Json?
  preNegotiationRates  Json?
  postNegotiationRates Json?
  creditInterestRates  Json?
  camfRate             Float?
  managementFeeRate    Float?
  fees                 Json? // array of { name, rate?, amount?, effectiveFrom?, effectiveTo? }
  returnChargeRate     Float?
  returnChargeLimit    Float?
  cotCovenantRate      Float?
  cotOffCoverRate      Float?
  cotOICRate           Float?
  turnoverLimit        Float?
  cotCovenantFrequency String?
  chargeCOTOnShortfall Boolean?
  debitRate            Float?
  excessRate           Float?
  excessRateType       String?
  vatRate              Float?
  whtRate              Float?
  rateType             String?
  currency             String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  comments     RateComment[]
  bank         Bank          @relation(fields: [bankId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[] // one rate config → many bank accounts
  documents    Document[]    @relation("RateDocuments")

  @@map("account_rates")
}

model RateComment {
  id            String    @id @default(uuid())
  content       String    @db.Text
  accountRateId String // 👈 Foreign key linking to AccountRate
  userId        String // 👈 Foreign key linking to the User who created the comment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  accountRate AccountRate @relation(fields: [accountRateId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rate_comments")
}

enum DocumentType {
  CONTRACT
  BANK_STATEMENT
}

model Document {
  id           String       @id @default(uuid())
  code         String       @unique
  title        String
  url          String
  type         DocumentType
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  rates AccountRate[] @relation("RateDocuments")
  bankAccounts BankAccount[] @relation("TransactionDocuments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model StaffAccountAssignment {
  id           String   @id @default(uuid())
  userId       String
  accountId    String
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  bankAccount BankAccount @relation(fields: [accountId], references: [id])
  assignedBy  User        @relation("AssignedBy", fields: [assignedById], references: [id])
  User        User[]      @relation("StaffAssignments")

  @@unique([userId, accountId])
  @@map("staff_account_assignments")
}

enum AnalysisTypeEnum {
  CAMF // Current Account Maintenance Fee
  COT // Commission on Turnover
  LOAN_INTEREST // Loan Interest
  LC // Letter of Credit
  WHT // Withholding Tax
}

model AnalysisType {
  id          String    @id @default(uuid())
  name        AnalysisTypeEnum    @unique // e.g., 'CAMF', 'COT'
  description String?   // Optional: User-friendly explanation for the UI
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("analysis_types")
}
